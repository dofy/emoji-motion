{
  "name": "native-emoji-motion",
  "version": "0.1.0",
  "description": "Expressive, extensible animations for native emoji with optional SVG effects",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    },
    "./vue": {
      "types": "./src/vue.d.ts",
      "import": "./src/vue.js"
    },
    "./svelte": {
      "types": "./src/svelte.d.ts",
      "import": "./src/svelte.js"
    },
    "./element": {
      "types": "./src/element.d.ts",
      "import": "./src/element.js"
    },
    "./svelte/EmojiMotion.svelte": {
      "types": "./src/EmojiMotion.svelte.d.ts",
      "svelte": "./src/EmojiMotion.svelte",
      "default": "./src/EmojiMotion.svelte"
    },
    "./lite": {
      "types": "./src/lite.d.ts",
      "import": "./src/lite.js",
      "default": "./src/lite.js"
    },
    "./react/lite": {
      "types": "./src/react.d.ts",
      "import": "./src/react-lite.js"
    },
    "./vue/lite": {
      "types": "./src/vue.d.ts",
      "import": "./src/vue-lite.js"
    },
    "./svelte/lite": {
      "types": "./src/svelte.d.ts",
      "import": "./src/svelte-lite.js"
    },
    "./svelte/EmojiMotionLite.svelte": {
      "types": "./src/EmojiMotion.svelte.d.ts",
      "svelte": "./src/EmojiMotionLite.svelte",
      "default": "./src/EmojiMotionLite.svelte"
    },
    "./element/lite": {
      "types": "./src/element.d.ts",
      "import": "./src/element-lite.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "UNICODE-LICENSE.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "node demo/server.js",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "build:demo": "node scripts/build-demo.js",
    "prepublishOnly": "npm test && npm run test:types",
    "test:types": "tsc --noEmit --strict --skipLibCheck false --module nodenext --moduleResolution nodenext --target es2022 type-tests/consumer.mts",
    "generate:unicode": "node scripts/generate-unicode.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "emoji",
    "emoji-animation",
    "animation",
    "web-animations",
    "svg",
    "skin-tone",
    "zero-dependencies"
  ],
  "sideEffects": [
    "./src/element.js",
    "./src/element-lite.js"
  ],
  "homepage": "https://emoji-motion.phpz.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dofy/emoji-motion.git"
  },
  "bugs": {
    "url": "https://github.com/dofy/emoji-motion/issues"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.3",
    "svelte4": "npm:svelte@^4.2.20",
    "typescript": "~5.9.3",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "svelte": "^4.0.0 || ^5.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
